{
	"name": "buckets-workspace",
	"private": true,
	"packageManager": "pnpm@11.0.9",
	"engines": {
		"node": ">=24",
		"pnpm": ">=11"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"build": "pnpm -r build",
		"compose:up": "docker compose up -d",
		"compose:down": "docker compose down -v",
		"lint": "biome check .",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"tsup": "^8.5.0",
		"typescript": "^5.8.3"
	}
}
